<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="32dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="BusFlow Tablet"
            android:textColor="@color/ink"
            android:textSize="28sp"
            android:fontFamily="@font/outfit"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:maxWidth="420dp"
            android:text="Type the 8-letter code from BusFlow\n(Routes &amp; Riders → Route Paths → Tablets)"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:maxWidth="420dp"
            android:gravity="center"
            android:hint="ABCD-EFGH"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
            android:maxLength="9"
            android:textSize="32sp"
            android:letterSpacing="0.15"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/bad"
            android:textSize="15sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pairButton"
            style="@style/BigButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Connect" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/wifi"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Wi-Fi"
            android:textAllCaps="false"
            android:textColor="@color/brand"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
